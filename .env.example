# Optional local development overrides. Copy this file to .env and export the
# values in your shell when needed. The UAH kernel does not load .env files.

# UAH_PYTHON_BIN=/absolute/path/to/python
# PRE_COMMIT_HOME=/absolute/path/to/pre-commit-cache

# Provider endpoints and credentials belong in the local .env only after the
# corresponding adapter contract exists. Never commit tokens or API keys.
