+def reconcile_header(before: str, reconciled_at: str) -> str:
+    boundary = re.search(r"(?m)^(?:#{2,6} | {0,3}(?:`{3,}|~{3,}))", before)
+    header_end = boundary.start() if boundary else len(before)
+    header = before[:header_end]
+    fields = list(re.finditer(r"(?m)^Reconciled:.*$", header))
+    if len(fields) != 1:
+        raise ValueError("dashboard requires one top reconciliation field")
+    field = fields[0]
+    title = re.match(r"\A# [^\n]+\n(?:[ \t]*\n)+", header)
+    if title is None or field.start() != title.end():
+        raise ValueError("reconciliation field must follow the dashboard title")
+    value = re.fullmatch(r"Reconciled: (\d{4}-\d{2}-\d{2})\.(.*)", field[0])
+    if value is None or (value[2] and not value[2].startswith(" ")):
+        raise ValueError("malformed top reconciliation field")
+    date.fromisoformat(value[1])
+    return before[:field.start()] + f"Reconciled: {reconciled_at}." + value[2] + before[field.end():]
+
+
